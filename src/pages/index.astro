---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryPath } from '../lib/categories';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---
<Layout
  title="Smart Picks, Clear Comparisons"
  description="PickLoot compares the best-value products by spec and price so you don't have to dig through hundreds of listings yourself."
>
  <p class="meta">Hand-picked product guides &amp; comparisons.</p>

  {categories.length > 0 && (
    <nav class="category-nav" aria-label="Browse by category">
      {categories.map(([category, count]) => (
        <a href={categoryPath(category)} class="category-tag category-tag-link">
          {category} <span class="count">{count}</span>
        </a>
      ))}
    </nav>
  )}

  {posts.length === 0 && (
    <p>No posts yet — check back soon.</p>
  )}
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={categoryPath(post.data.category)} class="category-tag category-tag-link">{post.data.category}</a>
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p class="excerpt">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
