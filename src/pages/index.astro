---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout
  title="Smart Picks, Clear Comparisons"
  description="PickLoot compares the best-value products by spec and price so you don't have to dig through hundreds of listings yourself."
>
  <p class="meta">Hand-picked product guides &amp; comparisons.</p>
  {posts.length === 0 && (
    <p>No posts yet — check back soon.</p>
  )}
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <span class="category-tag">{post.data.category}</span>
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p class="excerpt">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
