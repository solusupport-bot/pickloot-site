---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const updatedDate = post.data.updatedDate ?? post.data.publishDate;
const dateStr = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedDateStr = updatedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isoDate = post.data.publishDate.toISOString();
const isoUpdatedDate = updatedDate.toISOString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  dateModified: isoUpdatedDate,
  author: {
    '@type': 'Organization',
    name: 'PickLoot',
  },
  publisher: {
    '@type': 'Organization',
    name: 'PickLoot',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
};

const itemListSchema = post.data.products && post.data.products.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: post.data.products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      ...(p.price ? { offers: { '@type': 'Offer', price: p.price.replace(/[^0-9.]/g, ''), priceCurrency: 'USD' } } : {}),
    },
  })),
} : null;
---
<Layout title={post.data.title} description={post.data.description} image={post.data.heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  <span class="category-tag">{post.data.category}</span>
  <h1>{post.data.title}</h1>
  <p class="meta">
    Written &amp; researched by the PickLoot Editorial Team &middot; Published {dateStr}{isoUpdatedDate !== isoDate && <> &middot; Updated {updatedDateStr}</>} &middot; <a href="/editorial-policy">How we pick these</a>
  </p>

  {post.data.heroImage && (
    <figure class="hero-image">
      <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} loading="eager" width="1080" height="720" />
      {post.data.heroImageCreditName && (
        <figcaption>
          Photo by <a href={post.data.heroImageCreditUrl} target="_blank" rel="noopener">{post.data.heroImageCreditName}</a> on <a href="https://unsplash.com" target="_blank" rel="noopener">Unsplash</a> — for illustration; not the specific product reviewed.
        </figcaption>
      )}
    </figure>
  )}

  <div class="disclosure-banner">
    PickLoot displays advertising and may earn a commission from qualifying purchases made through affiliate links on this page, at no additional cost to you — see our <a href="/disclaimer">affiliate disclosure</a> for which programs are currently active.
  </div>

  <div class="prose">
    <Content />
  </div>

  {post.data.products && post.data.products.map((p) => (
    <ProductCard name={p.name} amazonUrl={p.amazonUrl} price={p.price} pros={p.pros} cons={p.cons} />
  ))}
</Layout>
