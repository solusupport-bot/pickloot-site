---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isoDate = post.data.publishDate.toISOString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    '@type': 'Organization',
    name: 'PickLoot',
  },
  publisher: {
    '@type': 'Organization',
    name: 'PickLoot',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
};

const itemListSchema = post.data.products && post.data.products.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: post.data.products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      ...(p.price ? { offers: { '@type': 'Offer', price: p.price.replace(/[^0-9.]/g, ''), priceCurrency: 'USD' } } : {}),
    },
  })),
} : null;
---
<Layout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  <span class="category-tag">{post.data.category}</span>
  <h1>{post.data.title}</h1>
  <p class="meta">Published {dateStr}</p>

  <div class="disclosure-banner">
    As an Amazon Associate, PickLoot earns from qualifying purchases. Some links on this page are affiliate links — see our <a href="/disclaimer">affiliate disclosure</a>.
  </div>

  <div class="prose">
    <Content />
  </div>

  {post.data.products && post.data.products.map((p) => (
    <ProductCard name={p.name} amazonUrl={p.amazonUrl} price={p.price} pros={p.pros} cons={p.cons} />
  ))}
</Layout>
